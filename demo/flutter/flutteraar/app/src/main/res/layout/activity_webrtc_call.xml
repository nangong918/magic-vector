<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvWebRtcCallStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="状态: 初始化中" />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/rendererLocal"
        android:layout_width="match_parent"
        android:layout_height="220dp" />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/rendererRemote"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ToggleButton
            android:id="@+id/btnWebRtcMute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textOff="静音关闭"
            android:textOn="静音开启" />

        <ToggleButton
            android:id="@+id/btnWebRtcCamera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textOff="摄像头开启"
            android:textOn="摄像头关闭" />

        <Button
            android:id="@+id/btnWebRtcHangup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="挂断" />
    </LinearLayout>
</LinearLayout>
