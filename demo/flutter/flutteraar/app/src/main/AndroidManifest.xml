<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlutterAar"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.activity.WifiDemoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.BatteryDemoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.IvwDemoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.VADMainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.LivePushDemoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.LivePullDemoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.LiveRtspFilePushDemoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.WebRtcDemoActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.activity.WebRtcCallActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.LocalMediaDemoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.LocalVideoPlayerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.CloudMediaDemoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.CloudVideoPlayerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.LocalHlsPlayerActivity"
            android:exported="false" />
        <service
            android:name=".webrtc.signaling.WebRtcSignalingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>