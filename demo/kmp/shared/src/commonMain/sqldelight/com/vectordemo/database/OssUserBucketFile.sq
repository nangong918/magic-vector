CREATE TABLE oss_user_bucket_file (
  user_id INTEGER NOT NULL,
  bucket_name TEXT NOT NULL,
  file_id TEXT NOT NULL,
  file_name TEXT NOT NULL,
  file_url TEXT NOT NULL,
  synced_at INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (user_id, bucket_name, file_id)
);

CREATE INDEX idx_oss_ubf_user ON oss_user_bucket_file(user_id);

distinctBuckets:
SELECT DISTINCT bucket_name FROM oss_user_bucket_file
WHERE user_id = ?
ORDER BY bucket_name ASC;

rowsInBucket:
SELECT * FROM oss_user_bucket_file
WHERE user_id = ? AND bucket_name = ?
ORDER BY file_id ASC;

countRealFiles:
SELECT COUNT(*) FROM oss_user_bucket_file
WHERE user_id = ? AND bucket_name = ? AND file_id != ?;

deleteAllForUserBucket:
DELETE FROM oss_user_bucket_file
WHERE user_id = ? AND bucket_name = ?;

deleteRow:
DELETE FROM oss_user_bucket_file
WHERE user_id = ? AND bucket_name = ? AND file_id = ?;

upsertOssRow:
INSERT OR REPLACE INTO oss_user_bucket_file(
  user_id,
  bucket_name,
  file_id,
  file_name,
  file_url,
  synced_at
) VALUES (?, ?, ?, ?, ?, ?);
