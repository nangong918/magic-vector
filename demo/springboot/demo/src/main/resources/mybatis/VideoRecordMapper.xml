<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo.mapper.VideoRecordMapper">

    <sql id="table">
        video_record
    </sql>

    <sql id="columns">
        id, user_id, file_id, video_name, file_size_bytes, duration_sec, bitrate_kbps,
        object_name, cover_object_name, hls_object_name, status, error_message, created_at, updated_at
    </sql>

    <insert id="insert">
        insert into
        <include refid="table"/>
        (
        <include refid="columns"/>
        )
        values (
        #{id}, #{userId}, #{fileId}, #{videoName}, #{fileSizeBytes}, #{durationSec}, #{bitrateKbps},
        #{objectName}, #{coverObjectName}, #{hlsObjectName}, #{status}, #{errorMessage}, #{createdAt}, #{updatedAt}
        )
    </insert>

    <select id="selectByFileId" resultType="com.demo.domain.entity.VideoRecordEntity">
        select
        <include refid="columns"/>
        from
        <include refid="table"/>
        where file_id = #{fileId}
        limit 1
    </select>

    <select id="selectByObjectName" resultType="com.demo.domain.entity.VideoRecordEntity">
        select
        <include refid="columns"/>
        from
        <include refid="table"/>
        where object_name = #{objectName}
        limit 1
    </select>

    <update id="updateByFileId">
        update
        <include refid="table"/>
        set video_name = #{videoName},
            file_size_bytes = #{fileSizeBytes},
            duration_sec = #{durationSec},
            bitrate_kbps = #{bitrateKbps},
            object_name = #{objectName},
            cover_object_name = #{coverObjectName},
            hls_object_name = #{hlsObjectName},
            status = #{status},
            error_message = #{errorMessage},
            updated_at = #{updatedAt}
        where file_id = #{fileId}
    </update>
</mapper>
