    "http://localhost:48888/user/password/update": {
      "post": {
        "summary": "User password update (auth)",
        "description": "需 Header user_id、access_token；前置脚本自动从环境/全局注入。",
        "tags": [
          "User"
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "header",
            "description": "标识用户的唯一ID，用于API请求中验证用户身份",
            "required": true,
            "example": "{{local_user_id}}",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "access_token",
            "in": "header",
            "description": "用于API身份验证的令牌，需有效且未过期",
            "required": true,
            "example": "{{local_access_token}}",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                },
                "example": ""
              }
            }
          },
          "404": {
            "description": "Fail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                },
                "example": ""
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": "{\n\t\"userId\": \"1\",\n\t\"oldPassword\": \"123456\",\n\t\"newPassword\": \"654321\"\n}"
            }
          }
        },
        "x-apipost-pre-script": "// [前置] 从环境变量或全局变量读取 token，自动写入请求头（与 AuthTokenInterceptor 一致）\nconst uid = apt.environment.get(\"local_user_id\") || apt.globals.get(\"local_user_id\") || \"\";\nconst tok = apt.environment.get(\"local_access_token\") || apt.globals.get(\"local_access_token\") || \"\";\nif (uid) apt.setRequestHeader(\"user_id\", uid);\nif (tok) apt.setRequestHeader(\"access_token\", tok);\n",
        "x-apipost-after-script": "// [后置] 改密成功后建议重新登录；此处仅清空 token 避免误用旧 token\nif (apt.response && apt.response.json && apt.response.json.data && apt.response.json.data.updated === true) {\n  apt.environment.unset(\"local_access_token\");\n  apt.globals.unset(\"local_access_token\");\n}",
        "event": [
          {
            "listen": "prerequest",
            "script": {
              "type": "text/javascript",
              "exec": [
                "// [前置] 从环境变量或全局变量读取 token，自动写入请求头（与 AuthTokenInterceptor 一致）",
                "const uid = apt.environment.get(\"local_user_id\") || apt.globals.get(\"local_user_id\") || \"\";",
                "const tok = apt.environment.get(\"local_access_token\") || apt.globals.get(\"local_access_token\") || \"\";",
                "if (uid) apt.setRequestHeader(\"user_id\", uid);",
                "if (tok) apt.setRequestHeader(\"access_token\", tok);",
                ""
              ]
            }
          },
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "// [后置] 改密成功后建议重新登录；此处仅清空 token 避免误用旧 token",
                "if (apt.response && apt.response.json && apt.response.json.data && apt.response.json.data.updated === true) {",
                "  apt.environment.unset(\"local_access_token\");",
                "  apt.globals.unset(\"local_access_token\");",
                "}"
              ]
            }
          }
        ]
      }
    },
