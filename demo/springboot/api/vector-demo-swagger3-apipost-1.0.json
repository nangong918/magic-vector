    "http://localhost:48888/user/register": {
      "post": {
        "summary": "User register",
        "description": "注册成功后执行后置脚本，写入 local_access_token / local_user_id（环境+全局）。",
        "tags": [
          "User"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                },
                "example": ""
              }
            }
          },
          "404": {
            "description": "Fail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                },
                "example": ""
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "account": {
                    "type": "string",
                    "example": "demo"
                  },
                  "password": {
                    "type": "string",
                    "example": "123456"
                  },
                  "name": {
                    "type": "string",
                    "example": "nick"
                  },
                  "avatar": {
                    "type": "string",
                    "format": "binary",
                    "description": "optional"
                  }
                },
                "required": [
                  "account",
                  "password"
                ]
              }
            }
          }
        },
        "x-apipost-after-script": "// [后置] 登录/注册成功后：写入环境变量 + 全局变量，供 OSS 等接口使用\nif (apt.response && apt.response.json && apt.response.json.data) {\n  const d = apt.response.json.data;\n  if (d.accessToken != null) {\n    const token = String(d.accessToken);\n    const uid = String(d.userId);\n    apt.environment.set(\"local_access_token\", token);\n    apt.environment.set(\"local_user_id\", uid);\n    apt.globals.set(\"local_access_token\", token);\n    apt.globals.set(\"local_user_id\", uid);\n  }\n}",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "// [后置] 登录/注册成功后：写入环境变量 + 全局变量，供 OSS 等接口使用",
                "if (apt.response && apt.response.json && apt.response.json.data) {",
                "  const d = apt.response.json.data;",
                "  if (d.accessToken != null) {",
                "    const token = String(d.accessToken);",
                "    const uid = String(d.userId);",
                "    apt.environment.set(\"local_access_token\", token);",
                "    apt.environment.set(\"local_user_id\", uid);",
                "    apt.globals.set(\"local_access_token\", token);",
                "    apt.globals.set(\"local_user_id\", uid);",
                "  }",
                "}"
              ]
            }
          }
        ]
      }
    },
