        "x-apipost-after-script": "// [后置] 可选：校验通过后同步变量（若接口返回了有效信息）\nif (apt.response && apt.response.json && apt.response.json.data) {\n  const d = apt.response.json.data;\n  if (d.valid === true && apt.environment.get(\"local_user_id\")) {\n    apt.globals.set(\"local_user_id\", String(apt.environment.get(\"local_user_id\")));\n    apt.globals.set(\"local_access_token\", String(apt.environment.get(\"local_access_token\") || \"\"));\n  }\n}",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "// [后置] 可选：校验通过后同步变量（若接口返回了有效信息）",
                "if (apt.response && apt.response.json && apt.response.json.data) {",
                "  const d = apt.response.json.data;",
                "  if (d.valid === true && apt.environment.get(\"local_user_id\")) {",
                "    apt.globals.set(\"local_user_id\", String(apt.environment.get(\"local_user_id\")));",
                "    apt.globals.set(\"local_access_token\", String(apt.environment.get(\"local_access_token\") || \"\"));",
