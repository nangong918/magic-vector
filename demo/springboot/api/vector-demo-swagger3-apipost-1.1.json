                "example": "{\n  \"code\": \"200\",\n  \"data\": {\n    \"userId\": \"1322596900\",\n    \"bucketName\": \"my-bucket\",\n    \"urlList\": [\"https://minio.example/presigned...\"]\n  }\n}"
              }
