                  "properties": {}
                },
                "example": "{\n  \"code\": \"200\",\n  \"data\": {\n    \"userId\": \"1322596900\",\n    \"bucketName\": \"my-bucket\",\n    \"fileIdList\": [\"1899123456789012345\"]\n  }\n}"
              }
            }
          },
          "404": {
            "description": "Fail",
            "content": {
              "application/json": {
                "schema": {
