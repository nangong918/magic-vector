                "const tok = apt.environment.get(\"local_access_token\") || apt.globals.get(\"local_access_token\") || \"\";",
                "if (uid) apt.setRequestHeader(\"user_id\", uid);",
                "if (tok) apt.setRequestHeader(\"access_token\", tok);",
                ""
              ]
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "UserIdHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "user_id"
      },
      "AccessTokenHeader": {
        "type": "apiKey",
        "in": "header",
